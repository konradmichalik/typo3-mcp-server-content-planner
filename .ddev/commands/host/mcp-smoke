#!/usr/bin/env bash

## Description: Smoke-test every typo3-mcp-server-content-planner MCP tool via the Inspector and print a pass/fail summary
## Usage: mcp-smoke [13|14]
## Example: "ddev mcp-smoke 13"

set -uo pipefail

VERSION="${1:-13}"
INSTANCE="/var/www/html/.Build/${VERSION}"

# The Inspector's positional-target argument parsing (`inspector <cmd...> --cli ...`)
# is unreliable across versions/argument shapes (silently falls back to --web mode,
# or misparses trailing flags). A generated --config/--server pair sidesteps that
# entirely and has proven reliable in practice.
CONFIG="$(mktemp -t mcp-smoke-config.XXXXXX.json)"
trap 'rm -f "${CONFIG}"' EXIT
cat > "${CONFIG}" <<JSON
{
  "mcpServers": {
    "content-planner": {
      "command": "ddev",
      "args": ["exec", "bash", "-c", "cd ${INSTANCE} && exec ./vendor/bin/typo3 mcp:server"]
    }
  }
}
JSON

# The root page (uid=1) always exists after `ddev install`, so every tool call
# below has a real record to operate on without needing extra fixtures. Tool
# argument values must stay single-word: they are word-split further down.
TESTS=(
  "ListContentPlannerStatuses|"
  "GetContentPlannerInfo|--tool-arg table=pages --tool-arg uid=1"
  "SetContentPlannerStatus|--tool-arg table=pages --tool-arg uid=1 --tool-arg status=Completed"
  "AddContentPlannerComment|--tool-arg table=pages --tool-arg uid=1 --tool-arg comment=mcp-smoke-test --tool-arg todos=[\"smoke\"]"
  "ListContentPlannerAssignees|"
  "SetContentPlannerAssignee|--tool-arg table=pages --tool-arg uid=1"
)

# The comment tools need a comment UID. GetContentPlannerInfo lists the newest
# comment first, so after the add above it is the one just created.
comment_uid() {
  npx --yes @modelcontextprotocol/inspector@latest --cli --config "${CONFIG}" --server content-planner \
    --method tools/call --tool-name GetContentPlannerInfo --tool-arg table=pages --tool-arg uid=1 2>/dev/null \
    | python3 -c 'import json,sys; print(json.loads(json.load(sys.stdin)["content"][0]["text"])["comments"][0]["uid"])'
}

# Call one tool over the real MCP protocol; succeeds when the result carries
# "isError": false. Returns the captured output on stdout.
call_tool() {
  local name="$1" args="$2"
  # shellcheck disable=SC2086
  npx --yes @modelcontextprotocol/inspector@latest --cli --config "${CONFIG}" --server content-planner \
    --method tools/call --tool-name "${name}" ${args} 2>/dev/null
}

printf "Smoke-testing typo3-mcp-server-content-planner MCP tools on TYPO3 v%s\n\n" "${VERSION}"
pass=0
fail=0
failed=()

# Runs one "Tool|args" entry, with one retry to absorb a transient failure.
run_test() {
  local entry="$1" name args ok=0
  name="${entry%%|*}"
  args="${entry#*|}"
  for attempt in 1 2; do
    if call_tool "${name}" "${args}" | grep -qE '"isError":[[:space:]]*false'; then
      ok=1
      break
    fi
    sleep 1
  done

  if [ "${ok}" -eq 1 ]; then
    printf "  \033[32m✔\033[0m %s\n" "${name}"
    pass=$((pass + 1))
  else
    printf "  \033[31m✘\033[0m %s\n" "${name}"
    fail=$((fail + 1))
    failed+=("${name}")
  fi
}

for entry in "${TESTS[@]}"; do
  run_test "${entry}"
done

uid="$(comment_uid)"
if [ -n "${uid}" ]; then
  for entry in \
    "SetContentPlannerTodoState|--tool-arg commentUid=${uid} --tool-arg todoIndex=0 --tool-arg resolved=true" \
    "UpdateContentPlannerComment|--tool-arg commentUid=${uid} --tool-arg comment=mcp-smoke-updated" \
    "SetContentPlannerCommentResolved|--tool-arg commentUid=${uid} --tool-arg resolved=true"; do
    run_test "${entry}"
  done
else
  printf "  \033[31m✘\033[0m could not determine a comment UID\n"
  fail=$((fail + 1))
fi

printf "\n%d passed, %d failed" "${pass}" "${fail}"
[ "${fail}" -gt 0 ] && printf " (%s)" "${failed[*]}"
printf "\n"
[ "${fail}" -eq 0 ]
